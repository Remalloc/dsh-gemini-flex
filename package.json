{
  "name": "dsh-gemini-flex",
  "version": "1.0.0",
  "description": "Use Gemini API Flex (and Standard/Priority) service tiers on DeepSeek Harness Google routes with quick UI toggles.",
  "author": "Remalloc",
  "license": "MIT",
  "homepage": "https://github.com/Remalloc/dsh-gemini-flex#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Remalloc/dsh-gemini-flex.git"
  },
  "bugs": {
    "url": "https://github.com/Remalloc/dsh-gemini-flex/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "gemini",
    "gemini-api",
    "flex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
